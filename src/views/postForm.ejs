<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Social Media - <%= post ? 'Editar' : 'Nuevo' %> Post</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
</head>
<body class="grey lighten-4">

  <nav>
    <div class="nav-wrapper teal">
      <a href="/" class="brand-logo center">Social Media</a>
    </div>
  </nav>

  <div class="container" style="margin-top: 30px;">
    <h4 class="center-align"><%= post ? 'Editar Post' : 'Nuevo Post' %></h4>

    <form action="<%= post ? ('/posts/' + post._id + '/edit') : '/posts' %>" method="POST">
      <% if (!post) { %>
        <div class="input-field">
          <select name="userId" required>
            <option value="" disabled selected>Selecciona un autor</option>
            <% users.forEach(function(u) { %>
              <option value="<%= u._id %>"><%= u.name %> <%= u.lastName %></option>
            <% }); %>
          </select>
          <label>Autor</label>
        </div>
      <% } %>

      <div class="input-field">
        <input type="text" name="title" id="title" minlength="5" maxlength="30" required value="<%= post ? post.title : '' %>">
        <label for="title" class="<%= post ? 'active' : '' %>">Título</label>
      </div>

      <div class="input-field">
        <textarea name="content" id="content" class="materialize-textarea" minlength="10" required><%= post ? post.content : '' %></textarea>
        <label for="content" class="<%= post ? 'active' : '' %>">Contenido</label>
      </div>

      <div class="input-field">
        <input type="text" name="hashtags" id="hashtags" value="<%= post && post.hashtags ? post.hashtags.join(', ') : '' %>">
        <label for="hashtags" class="<%= post ? 'active' : '' %>">Hashtags (separados por coma)</label>
      </div>

      <div class="input-field">
        <input type="text" name="imageUrl" id="imageUrl" value="<%= post ? (post.imageUrl || '') : '' %>">
        <label for="imageUrl" class="<%= post ? 'active' : '' %>">URL de la imagen</label>
      </div>

      <button type="submit" class="btn waves-effect waves-light teal">
        <%= post ? 'Guardar cambios' : 'Publicar' %>
      </button>
      <a href="/posts" class="btn-flat">Cancelar</a>
    </form>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>