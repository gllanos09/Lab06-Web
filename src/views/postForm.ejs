<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Social Media - <%= post ? 'Editar' : 'Nuevo' %> post</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/" class="navbar__brand">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
      Social Media
    </a>
    <a href="/posts" class="btn btn-ghost">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      Volver
    </a>
  </nav>

  <main class="page">
    <div class="page-header">
      <div>
        <h2><%= post ? 'Editar post' : 'Nuevo post' %></h2>
        <p><%= post ? 'Actualiza el contenido de tu publicación.' : 'Comparte algo nuevo con la comunidad.' %></p>
      </div>
    </div>

    <div class="form-layout">
      <aside class="form-preview">
        <div class="form-preview__media">
          <img id="formPreviewImage" class="form-preview__image"
               style="<%= post && post.imageUrl ? '' : 'display:none;' %>"
               src="<%= post && post.imageUrl ? post.imageUrl : '' %>"
               alt="Vista previa de la imagen">
          <div id="formPreviewPlaceholder" class="form-preview__placeholder" style="<%= post && post.imageUrl ? 'display:none;' : '' %>">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span>La imagen aparecerá aquí</span>
          </div>
        </div>
        <div class="form-preview__body">
          <span id="formPreviewTitle" class="form-preview__title"><%= post ? post.title : 'Título del post' %></span>
          <div id="formPreviewTags" class="form-preview__tags">
            <% if (post && post.hashtags && post.hashtags.length) { %>
              <% post.hashtags.forEach(function(tag) { %><span class="chip">#<%= tag %></span><% }); %>
            <% } %>
          </div>
        </div>
      </aside>

      <form class="form-card" action="<%= post ? ('/posts/' + post._id + '/edit') : '/posts' %>" method="POST">
        <% if (!post) { %>
          <div class="field">
            <label for="userId">Autor</label>
            <select name="userId" id="userId" required>
              <option value="" disabled selected>Selecciona un autor</option>
              <% users.forEach(function(u) { %>
                <option value="<%= u._id %>"><%= u.name %> <%= u.lastName %></option>
              <% }); %>
            </select>
          </div>
        <% } %>

        <div class="field">
          <label for="title">Título</label>
          <input type="text" name="title" id="title" minlength="5" maxlength="30" required value="<%= post ? post.title : '' %>">
          <p class="hint">Entre 5 y 30 caracteres.</p>
        </div>

        <div class="field">
          <label for="content">Contenido</label>
          <textarea name="content" id="content" minlength="10" required><%= post ? post.content : '' %></textarea>
          <p class="hint">Mínimo 10 caracteres.</p>
        </div>

        <div class="field">
          <label for="hashtags">Hashtags</label>
          <input type="text" name="hashtags" id="hashtags" placeholder="nodejs, mongo, tecsup" value="<%= post && post.hashtags ? post.hashtags.join(', ') : '' %>">
          <p class="hint">Sepáralos con comas.</p>
        </div>

        <div class="field">
          <label for="imageUrl">URL de la imagen</label>
          <input type="url" name="imageUrl" id="imageUrl" placeholder="https://..." value="<%= post ? (post.imageUrl || '') : '' %>">
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary"><%= post ? 'Guardar cambios' : 'Publicar' %></button>
          <a href="/posts" class="btn btn-ghost">Cancelar</a>
        </div>
      </form>
    </div>
  </main>

  <script>
    (function () {
      var imageInput = document.getElementById('imageUrl');
      var previewImage = document.getElementById('formPreviewImage');
      var placeholder = document.getElementById('formPreviewPlaceholder');
      var titleInput = document.getElementById('title');
      var previewTitle = document.getElementById('formPreviewTitle');
      var hashtagsInput = document.getElementById('hashtags');
      var previewTags = document.getElementById('formPreviewTags');

      function escapeHtml(str) {
        return str.replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      function updateImage() {
        var url = imageInput.value.trim();
        if (url) {
          previewImage.src = url;
          previewImage.style.display = 'block';
          placeholder.style.display = 'none';
        } else {
          previewImage.style.display = 'none';
          placeholder.style.display = 'flex';
        }
      }
      previewImage.addEventListener('error', function () {
        previewImage.style.display = 'none';
        placeholder.style.display = 'flex';
      });
      imageInput.addEventListener('input', updateImage);

      titleInput.addEventListener('input', function () {
        previewTitle.textContent = titleInput.value.trim() || 'Título del post';
      });

      hashtagsInput.addEventListener('input', function () {
        var tags = hashtagsInput.value.split(',').map(function (t) { return t.trim(); }).filter(Boolean);
        previewTags.innerHTML = tags.map(function (t) { return '<span class="chip">#' + escapeHtml(t) + '</span>'; }).join('');
      });
    })();
  </script>
</body>
</html>